# Keeps the build context (everything `COPY . .` can reach) free of secrets and local state.

# Secrets: every .env* file holds real values (.env.example is not needed in an image), keys
.env*
**/.env*
*.pem
**/*.pem
*.key
**/*.key
.npmrc
**/.npmrc

# Database dumps
*.sql
*.dump

# Version control, CI, editor and tool settings, git hook shims
.git
.github
.husky/_
.vscode
.idea
.vercel
.claude

# Dependencies and build output: the image installs and builds its own
node_modules
**/node_modules
.next
out
build
next-env.d.ts
*.tsbuildinfo

# Local uploads at the repo root (media lives in MinIO)
media

# Test and scratch output, logs
coverage
test-results
playwright-report
*.log
**/*.log
.DS_Store

# The Docker files themselves (editing them must not invalidate the `COPY . .` layer)
Dockerfile
.dockerignore
docker-compose.yml
