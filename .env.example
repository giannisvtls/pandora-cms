# Copy to .env for local development. The values below match docker-compose.yml's local stack,
# except PAYLOAD_SECRET: replace it with a random string (for example `openssl rand -hex 32`).
# Tests never use DATABASE_URL's database or S3_BUCKET: they create a throwaway database and
# bucket on the same servers for each run.

# Postgres (docker compose service `postgres`, host port 5442)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5442/pandora_cms

# Signs auth tokens. Any long random string locally; a real secret on a server.
PAYLOAD_SECRET=replace-with-a-random-hex-string

# Media storage: MinIO through the S3 API (docker compose service `minio`, host port 9100)
S3_ENDPOINT=http://127.0.0.1:9100
S3_BUCKET=pandora-cms-media
S3_ACCESS_KEY_ID=pandora-local
S3_SECRET_ACCESS_KEY=pandora-local-secret

# Admin user: `npm run seed` creates it in DATABASE_URL's database when no user has this email (it
# never changes an existing user), and `npm run smoke` logs in with it. Placeholders: choose your
# own; neither script prints the password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional, tests only: how long the test setup waits for its `payload migrate` steps on the
# throwaway database (migrate, undo with migrate:down and migrate:reset, re-migrate; one limit for
# all of them), in milliseconds (default 480000; at most 2147483647).
# INT_MIGRATE_TIMEOUT_MS=480000
